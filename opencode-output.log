import pro.coreservermod.ConfigFixer;
import java.nio.file.*;

public class TestConfigFixer {
    public static void main(String[] args) throws Exception {
        Path p = Files.createTempFile("coreservermod", ".json");
        String original = "{\n  \"sugar_cane_soul_sand_enabled\": false,\n  \"sapling_growth_time_seconds\": 42,\n  \"custom_legacy_key\": \"keep-me\"\n}";
        Files.writeString(p, original);

        if (!ConfigFixer.fix(p)) throw new AssertionError("expected fix to report a change");
        String fixed = Files.readString(p);
        if (!fixed.contains("\"sugar_cane_soul_sand_enabled\": false")) throw new AssertionError("existing boolean changed");
        if (!fixed.contains("\"sapling_growth_time_seconds\": 42")) throw new AssertionError("existing int changed");
        if (!fixed.contains("\"custom_legacy_key\": \"keep-me\"")) throw new AssertionError("unknown legacy key lost");
        if (!fixed.contains("\"crop_growth_time_seconds\": 15")) throw new AssertionError("missing new key not added");
        if (!fixed.contains("\"create_flowing_water_washing_interval_ticks\": 10")) throw new AssertionError("last default key not added");

        if (ConfigFixer.fix(p)) throw new AssertionError("second fix should be a no-op");

        String invalid = "{ not valid json";
        Files.writeString(p, invalid);
        ConfigFixer.fix(p);
        if (!Files.readString(p).equals(invalid)) throw new AssertionError("invalid JSON was overwritten");

        System.out.println("ConfigFixer tests passed");
        Files.deleteIfExists(p);
    }
}
EOF
