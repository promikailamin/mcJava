                    for (int x = 0; x < 16; ++x) {
                        BlockState state = section.getBlockState(x, y, z);
                        if (!predicate.test(state)) continue;
                        consumer.accept(mutablePos.setWithOffset(origin, x, y, z), state);
                    }
                }
            }
        }
    }

